msgctxt "Addons::name::stripe"
msgid "Stripe payments"
msgstr "Plăți Stripe"

msgctxt "Addons::description::stripe"
msgid "A Stripe solution for online stores. Lets you accept payments through Stripe and other means."
msgstr "O soluție Stripe pentru magazinele online. Vă permite să acceptați plăți prin Stripe și alte mijloace."

msgctxt "Languages::stripe.stripe"
msgid "Stripe"
msgstr "Stripe"

msgctxt "Languages::stripe.publishable_key"
msgid "Publishable key"
msgstr "Cheie publicabilă"

msgctxt "Languages::stripe.private_api_key"
msgid "Private API key"
msgstr "Cheie API privată"

msgctxt "Languages::stripe.private_api_key.tooltip"
msgid "<p>You can use either:</p><ul><li><code>sk_...</code> — full access secret key</li><li><code>rk_...</code> — restricted key with limited permissions (recommended by Stripe)</li></ul><p>If you use a restricted key, give it <strong>Write</strong> permission for the following sections:</p><ul><li>Checkout</li><li>Webhook</li></ul>"
msgstr "<p>Puteți folosi oricare dintre următoarele:</p><ul><li><code>sk_...</code> — cheie secretă cu acces complet</li><li><code>rk_...</code> — cheie restricționată cu permisiuni limitate (recomandată de Stripe)</li></ul><p>Dacă utilizați o cheie restricționată, acordați-i permisiunea <strong>de scriere</strong> pentru următoarele secțiuni:</p><ul><li>de finalizare a comenzii</li><li>Webhook</li></ul>"

msgctxt "Languages::stripe.payment_type"
msgid "Payment type"
msgstr "Tipul de plată"

msgctxt "Languages::stripe.payment_type.card"
msgid "Credit card"
msgstr "Card de credit"

msgctxt "Languages::stripe.payment_type.apple_pay"
msgid "Apple Pay"
msgstr "Apple Pay"

msgctxt "Languages::stripe.payment_type.apple_pay.description"
msgid "<p>Apple's <a href=\"[guidelines_url]\" target=\"_blank\">Human Interface Guidelines</a> require you to display the Apple Pay mark on the checkout page.</p><p>You can set the following image as the payment method icon or use it in the payment method description:</p>"
msgstr "<p>Ghidurile Apple <a href=\"[guidelines_url]\" target=\"_blank\">privind interfața umană</a> vă solicită să afișați marcajul Apple Pay pe pagina de finalizare a comenzii.</p><p>Puteți seta următoarea imagine ca pictogramă metodei de plată sau o puteți utiliza în descrierea metodei de plată:</p>"

msgctxt "Languages::stripe.payment_type.google_pay"
msgid "Google Pay"
msgstr "Google Pay"

msgctxt "Languages::stripe.payment_type.google_pay.description"
msgid "<p>Google's <a href=\"[guidelines_url]\" target=\"_blank\">Brand guidelines</a> require you to display the Google Pay mark on the checkout page.</p><p>You can set the following image as the payment method icon or use it in the payment method description:</p>"
msgstr "<p>Ghidul Google <a href=\"[guidelines_url]\" target=\"_blank\">privind mărcile</a> vă solicită să afișați marca Google Pay pe pagina de finalizare a comenzii.</p><p>Puteți seta următoarea imagine ca pictogramă metodei de plată sau o puteți utiliza în descrierea metodei de plată:</p>"

msgctxt "Languages::stripe.online_payment"
msgid "Online payment"
msgstr "Plata online"

msgctxt "Languages::stripe.test_payment"
msgid "Test payment (won't be charged)"
msgstr "Plata de testare (nu va fi taxată)"

msgctxt "Languages::stripe.test_payment.description"
msgid "Your card won't be charged when using Apple Pay or Google Pay."
msgstr "Cardul dvs. nu va fi debitat când utilizați Apple Pay sau Google Pay."

msgctxt "Languages::stripe.apple_pay_not_supported"
msgid "Apple Pay is not supported on this device"
msgstr "Apple Pay nu este acceptat pe acest dispozitiv"

msgctxt "Languages::stripe.google_pay_not_supported"
msgid "Google Pay is not supported on this device"
msgstr "Google Pay nu este acceptat pe acest dispozitiv"

msgctxt "Languages::stripe.token"
msgid "Stripe payment token"
msgstr "Jeton de plată Stripe"

msgctxt "Languages::stripe.account_country"
msgid "Stripe account country"
msgstr "Țara contului Stripe"

msgctxt "Languages::stripe.show_payment_button"
msgid "Show \"[button_name]\" button on product pages"
msgstr "Afișați butonul „[button_name]” pe paginile produselor"

msgctxt "Languages::stripe.payment_type.buy_with_apple_pay"
msgid "Buy with Apple Pay"
msgstr "Cumpărați cu Apple Pay"

msgctxt "Languages::stripe.payment_type.buy_with_google_pay"
msgid "Buy with Google Pay"
msgstr "Cumpărați cu Google Pay"

msgctxt "Languages::stripe.payment_intent_error"
msgid "An error occurred when creating a PaymentIntent with the payment #[payment_id]: [error]"
msgstr "A apărut o eroare la crearea unui PaymentIntent cu plata #[payment_id]: [error]"

msgctxt "Languages::stripe.webhook_register_error"
msgid "An error occurred while registering the webhook for the payment #[payment_id]: [error]"
msgstr "A apărut o eroare la înregistrarea webhook-ului pentru plata #[payment_id]: [error]"

msgctxt "Languages::stripe.webhook_restricted_key_webhook_write_required"
msgid "Failed to create a webhook endpoint. To fix this, open your Stripe Dashboard, go to Developers → API keys, edit your restricted key, and set Webhook Endpoints permission to Write."
msgstr "Nu s-a putut crea un endpoint webhook. Pentru a remedia acest lucru, deschideți tabloul de bord Stripe, accesați Dezvoltatori → Chei API, editați cheia restricționată și setați permisiunea Endpoint-uri Webhook la Scriere."

msgctxt "Languages::stripe.webhook_handle_error"
msgid "An error occurred while processing the webhook: [error]"
msgstr "A apărut o eroare la procesarea webhook-ului: [error]"

msgctxt "Languages::stripe.merchant_identifier"
msgid "Merchant identifier"
msgstr "Identificatorul comerciantului"

msgctxt "Languages::stripe.stripe_cookie_title"
msgid "Stripe"
msgstr "Stripe"

msgctxt "Languages::stripe.stripe_cookie_description"
msgid "Stripe is a payment provider. It allows us to accept payments, if you choose a payment method powered by Stripe. Here is <a href=\"https://stripe.com/privacy\" target=\"_blank\">Stripe privacy policy</a>."
msgstr "Stripe este un furnizor de plăți. Ne permite să acceptăm plăți, dacă alegeți o metodă de plată alimentată de Stripe. Iată politica de confidențialitate <a href=\"https://stripe.com/privacy\" target=\"_blank\">Stripe</a>."

msgctxt "Languages::stripe.payment_type.stripe_checkout"
msgid "Stripe Checkout"
msgstr "Stripe Checkout"

msgctxt "Languages::stripe.payment_type.stripe_checkout.description"
msgid "<p>Take customers to the Stripe Checkout page to complete the payment. We recommend it because that page offers many more payment options than CS-Cart checkout page. You can see those payment options <a href=\"https://dashboard.stripe.com/settings/payment_methods\" target=\"_blank\">on your Stripe Dashboard</a>.</p>"
msgstr "<p>Aduceți clienții la pagina Stripe Checkout pentru a finaliza plata. Îl recomandăm deoarece pagina respectivă oferă mult mai multe opțiuni de plată decât pagina de finalizare a achiziției CS-Cart. Puteți vedea acele opțiuni de plată <a href=\"https://dashboard.stripe.com/settings/payment_methods\" target=\"_blank\">pe tabloul de bord Stripe</a>.</p>"

msgctxt "Languages::stripe.session_checkout_error"
msgid "There is no supported payment method in Stripe Checkout for the specified parameters."
msgstr "Nu există o metodă de plată acceptată în Stripe Checkout pentru parametrii specificați."

msgctxt "Languages::stripe.payment_intent_id"
msgid "Payment intent ID"
msgstr "ID intenția de plată"

